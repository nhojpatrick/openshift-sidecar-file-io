#!/bin/bash

if [ "$#" -ne 1 ]; then
	echo "illegal number of parameters"
fi

FILE=$1

echo `date -u +"%Y-%m-%dT%H:%M:%SZ"` `hostname` "File Checking '${FILE}'"

while ! test -f "${FILE}"; do
	sleep 1 ;
	echo "File Missing '${FILE}'" ;
done

echo `date -u +"%Y-%m-%dT%H:%M:%SZ"` `hostname` "File Exists '${FILE}'"

tail -f ${FILE} ;
